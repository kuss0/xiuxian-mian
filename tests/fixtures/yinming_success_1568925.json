      "text": ".往 中"
    },
    {
      "chat_id": -1002083016447,
      "topic_id": 0,
      "message_id": 1568873,
      "reply_to_msg_id": 0,
      "sender_id": 8816935632,
      "server_event_at": 1794495440.0,
      "text": "@CqdOps 选了中边——雾气渐淡，路是通的。"
    },
