# Telegram API 凭据
# 在 https://my.telegram.org/apps 创建应用后获取
api_id = 0
api_hash = ""

# 日志复盘群 ID
# 用于接收审计日志、远程指令控制（如 .登录 .状态 .全局暂停 等）
log_group_id = 0

# 日志群发送模式：account / bot
# - account: 使用当前登录账号发送
# - bot: 使用 Telegram bot 发送（若 token 缺失或发送失败会回退到账号发送）
log_send_mode = "account"

# 当 log_send_mode = "bot" 时使用的 bot token
log_bot_token = ""

# 发送游戏指令的身份 ID 列表，支持多个身份同时运行
# 填写 Telegram 用户 ID 或频道 ID
send_as_ids = []

# 管理员 Telegram 用户 ID
# 只有该用户在日志群发送的指令才会被响应
admin_id = 0
