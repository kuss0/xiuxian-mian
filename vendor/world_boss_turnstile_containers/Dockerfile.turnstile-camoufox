FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/home/turnstile \
    XDG_CACHE_HOME=/home/turnstile/.cache \
    QYZ_BROKER_HOST=0.0.0.0 \
    QYZ_BROKER_PORT=8192 \
    QYZ_BROKER_WORKERS=1 \
    QYZ_BROKER_MAX_QUEUE=8 \
    QYZ_BROKER_PROFILE_ROOT=/var/lib/turnstile/profiles \
    QYZ_BROKER_BROWSER_ENGINE=camoufox \
    QYZ_BROKER_DISPLAY_MODE=xvfb \
    QYZ_BROKER_FINGERPRINT_OS=windows \
    QYZ_BROKER_FINGERPRINT_LOCALE=zh-CN

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        fonts-noto-cjk \
        gosu \
        xdotool \
        xvfb \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin turnstile \
    && mkdir -p /var/lib/turnstile/profiles /home/turnstile/.cache \
    && chown -R turnstile:turnstile /var/lib/turnstile /home/turnstile \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.turnstile-camoufox.txt .
RUN pip install --no-cache-dir -r requirements.turnstile-camoufox.txt \
    && python -m playwright install-deps firefox \
    && rm -rf /var/lib/apt/lists/*

# Camoufox 按当前运行用户查找浏览器包，构建时即下载到同一 HOME。
RUN gosu turnstile python -m camoufox fetch

COPY scripts/world_boss_turnstile_broker.py /app/world_boss_turnstile_broker.py
COPY docker/turnstile-broker-entrypoint.sh /usr/local/bin/turnstile-broker-entrypoint
RUN chmod 0755 /usr/local/bin/turnstile-broker-entrypoint

EXPOSE 8192

HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=3 \
  CMD python -c "import json,urllib.request; d=json.load(urllib.request.urlopen('http://127.0.0.1:8192/healthz', timeout=3)); raise SystemExit(0 if d.get('ok') else 1)"

ENTRYPOINT ["/usr/local/bin/turnstile-broker-entrypoint"]
