# Telegram API 凭据
# 在 https://my.telegram.org/apps 创建应用后获取
API_ID=0
API_HASH=

# Telegram 代理配置（可选）
# 可选值：http / socks5；留空表示直连
# TG_PROXY_HOST 直接写 host:port，默认可用 127.0.0.1:7890
TG_PROXY_TYPE=
TG_PROXY_HOST=127.0.0.1:7890
TG_PROXY_USERNAME=
TG_PROXY_PASSWORD=

# 天道 Mini App 验证配置（默认一般无需修改）
TIANDAO_MINIAPP_VERIFY_URL=https://asc.aiopenai.app/miniapp/xianxia-verify
TIANDAO_MINIAPP_BOT_USERNAME=fanrenxiuxian_bot

# 日志复盘群 ID
# 用于接收审计日志、远程指令控制（如 .登录 .状态 .全局暂停 等）
LOG_GROUP_ID=0

# 日志群发送模式：account / bot
# - account: 使用当前登录账号发送
# - bot: 使用 Telegram bot 发送（若 token 缺失或发送失败会回退到账号发送）
LOG_SEND_MODE=account

# 当 LOG_SEND_MODE=bot 时使用的 bot token
LOG_BOT_TOKEN=

# 低优先级审计日志不实时刷屏，按间隔汇总到日志群
LOG_GROUP_LOW_PRIORITY_SUMMARY_INTERVAL_SEC=600
LOG_GROUP_LOW_PRIORITY_SUMMARY_MAX_DETAILS=20

# 管理员 Telegram 用户 ID（必须大于 0；多个用逗号分隔）
# 只有这些用户在日志群发送的指令才会被响应
ADMIN_ID=123456789

# Web UI 启动配置
CHAOGU_UI_HOST=0.0.0.0
CHAOGU_UI_PORT=3030
CHAOGU_UI_PUBLIC_BASE_URL=

# UI 认证超时（秒）
CHAOGU_UI_AUTH_IDLE_TIMEOUT_SEC=3600
CHAOGU_UI_AUTH_SESSION_TIMEOUT_SEC=86400
