[Unit]
Description=Xiuxian read-only runtime health observer
After=network.target xiuxian.service
Wants=xiuxian.service

[Service]
Type=simple
WorkingDirectory=/opt/xiuxian-main
ExecStart=/opt/xiuxian-main/.venv/bin/python /opt/xiuxian-main/tools/health_observer.py --project-root /opt/xiuxian-main --service xiuxian.service --service xiuxian-listener.service --service xiuxian-safety-watchdog.service --interval 60 --journal-window-sec 600 --max-event-lines 5000
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
