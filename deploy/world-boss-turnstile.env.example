WORLD_BOSS_TURNSTILE_ONLY_IDENTITY=
WORLD_BOSS_TURNSTILE_BROKER_URL=http://127.0.0.1:8193
WORLD_BOSS_TURNSTILE_TIMEOUT_SECONDS=60
# Must match the standalone broker; fill locally, never include in a patch.
TURNSTILE_BROKER_SECRET=
