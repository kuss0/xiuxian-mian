[Unit]
Description=Xiuxian external safety watchdog
After=network.target xiuxian.service
Wants=xiuxian.service

[Service]
Type=simple
WorkingDirectory=/opt/xiuxian-main
ExecStart=/opt/xiuxian-main/.venv/bin/python /opt/xiuxian-main/tools/safety_watchdog.py --project-root /opt/xiuxian-main --service xiuxian --interval 15 --action soft
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
